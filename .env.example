# Akasha v1 has no authentication. Keep it on a trusted LAN.
# The container's data, Calibre and database paths are fixed by the image and
# its mounts (/data, /calibre); they cannot be overridden through this file.
GOOGLE_BOOKS_API_KEY=
USER_AGENT_CONTACT=you@example.com
TZ=UTC
LOG_LEVEL=INFO
BOOK_TRACKER_ENVIRONMENT=development
BOOK_TRACKER_SQLITE_BUSY_TIMEOUT_MS=5000

# Per-file cap on attachments, in bytes. Default 25 MiB: enough for an epub, a
# PDF scan or a comic issue, not for an audiobook. Bounds the worst single file,
# not the total — with no auth, anyone on the LAN can still fill the disk.
# BOOK_TRACKER_ATTACHMENT_MAX_BYTES=26214400

# The movie domain's poster fallback, for films that carry a TMDB id but no
# IMDb id. Optional and narrow: without it those films stay coverless and
# nothing else changes — the keyless primary source needs no configuration.
# TMDB_READ_TOKEN=

# data and backups are named Docker volumes by default (DEC-075), not host
# directories — nothing to create or chown. Override the volume names if you
# want to be explicit about them, or to point a fresh install at an existing
# volume:
# AKASHA_DATA_VOLUME=akasha_data
# AKASHA_BACKUP_VOLUME=akasha_backups
#
# Want ./data or ./backups as real host directories instead — a NAS share for
# BACKUP_DIR, direct host access to the sqlite file? Run with
# `docker compose -f compose.yaml -f compose.bind-mounts.yaml up -d`, which
# reads the two variables below (and brings back needing to `mkdir` and
# `chown 10001:10001` them yourself).
# DATA_DIR=./data
# BACKUP_DIR=./backups
#
# Backups on their own disk without moving the database off its named volume —
# DEC-040's two-disk shape — is a third overlay, and it reads BACKUP_DIR too:
#   mkdir -p /mnt/second-disk/akasha-backups
#   sudo chown 10001:10001 /mnt/second-disk/akasha-backups
#   docker compose -f compose.yaml -f compose.backups-host.yaml up -d
#
# BACKUP_RETENTION is read by scripts/backup.sh from the *process
# environment*, and cron does not source .env — set it in the crontab line or
# the environment, not here.
BACKUP_RETENTION=7
# Your Calibre library, mounted read-only. Create the directory even if empty.
CALIBRE_DIR=./calibre
# 0.0.0.0 publishes on every interface — including the extra interface a VPN
# or mesh network (WireGuard, Tailscale, ZeroTier and the like) adds. Bind one
# address to exclude it; 127.0.0.1 keeps it on this machine.
AKASHA_BIND=0.0.0.0
AKASHA_PORT=4441
# The tag compose runs. Pin a version (docker compose build with
# AKASHA_VERSION=1.5.1 tags the image) so an upgrade or a rollback is a
# variable rather than a rebuild from an old commit. `local` is the build you
# just made.
# AKASHA_VERSION=local

# Per-file cap on attachments, in bytes. Default 25 MiB: enough for an epub, a
# PDF scan or a comic issue, not for an audiobook. Bounds the worst single file,
# not the total — with no auth, anyone on the LAN can still fill the disk.
# BOOK_TRACKER_ATTACHMENT_MAX_BYTES=26214400
# Container log bound: 10 MiB x 5 files, so a chatty incident cannot fill the
# disk. Override in the same shape as everything else here.
# AKASHA_LOG_MAX_SIZE=10m
# AKASHA_LOG_MAX_FILE=5
