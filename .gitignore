# Runtime data and secrets
# Source exports the owner drops here to import. They carry account ids and
# usernames, and AGENTS.md forbids committing uploaded imports; test fixtures are
# trimmed and anonymised copies under backend/tests/fixtures/imports/ instead.
animelist_*.xml
animelist_*.xml.gz
goodreads_library_export*.csv
.env
.env.*
!.env.example
data/
# Tier-2 opt-in bind mounts only (compose.bind-mounts.yaml) — the default
# deployment uses named Docker volumes instead. Backups contain the database
# and covers verbatim.
backups/
calibre/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Editors and OS
.idea/
.vscode/
.DS_Store

# Agent scratch files
.hermes/
frontend/e2e/scratchpad/

# The owner's private Letterboxd export. Read-only walkthrough input for the
# movie importer; never a fixture and never committed. Sprint 048's release
# commit picked it up through `git add -A`, which is why the pattern is here
# rather than relying on anyone remembering.
letterboxd-*.zip

# Where the owner now drops every private source export before an importer
# walkthrough: Letterboxd, MyAnimeList, IMDb, Trakt, Spotify. Every one of them
# carries account ids, usernames, email addresses and personal ratings. The
# directory is ignored wholesale rather than pattern by pattern, because IMDb
# names its CSVs after a list UUID and no pattern would have caught them. Test
# fixtures stay trimmed and anonymised under backend/tests/fixtures/imports/.
exports/
